# Copy to .env (repo root and/or each services/<name>/.env) and fill real values.
# Spring loads optional:file:.env from the process working directory (service folder when using launch.json).

# MySQL ngoài Docker (server DB riêng). App container đọc DB_HOST từ đây.
# Nếu MySQL cùng máy với Docker: thường dùng IP private của host, hoặc host.docker.internal
# Schema: chạy infra/mysql/local-create-databases.sql trên MySQL đó.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
# DB_NAME do docker-compose gán theo từng service (identity_db, ...)

# Redis (identity-service) — host port 6380: 6379 trên máy này đã bị 1 project khác (Rencity) chiếm
REDIS_URL=redis://localhost:6380

# RabbitMQ (event-service + notification-service) — host port 5673/15673 vì lý do tương tự (5672/15672 đã bị chiếm)
RABBITMQ_USERNAME=app_user
RABBITMQ_PASSWORD=changeme_rabbit
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673

# JWT — cùng secret trên mọi service
JWT_SECRET=replace_with_a_real_base64_secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_internal_token

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=changeme_superadmin_password

SMTP_USERNAME=changeme@gmail.com
SMTP_PASSWORD=changeme_app_password

FCM_CREDENTIALS_JSON=changeme_path_or_inline_json
FCM_TOKEN_RETENTION_DAYS=90

IDENTITY_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
EVENT_SERVICE_URL=http://localhost:8083
CUSTOMER_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085

# Khoá mã hoá số tài khoản ngân hàng (bắt buộc cho identity-service). Tạo: openssl rand -base64 32
# Sao lưu riêng; mất khoá là mất dữ liệu đã mã hoá. Khoá server dev và máy local phải GIỐNG nhau nếu dùng chung DB.
DATA_ENCRYPTION_KEY=

# Ảnh/video: FPT S3 (catalog-service). Để trống ACCESSKEY/SECRET thì lưu thư mục local (chỉ dùng khi dev).
# Bucket dùng chung: file nằm ở images/<S3_FPT_FOLDER>/ và videos/<S3_FPT_FOLDER>/ (đã mở đọc công khai).
S3_FPT_ACCESSKEY_ID=
S3_FPT_SECRET_ACCESS_KEY=
S3_FPT_ENDPOINT=https://s3-han02.fptcloud.com
S3_FPT_REGION=han02
S3_FPT_BUCKET_NAME=tns-s3
S3_FPT_PUBLIC_ENDPOINT=https://s3-han02.fptcloud.com/tns-s3
S3_FPT_FOLDER=stagio
# Chat chỉ nhận ảnh có URL bắt đầu bằng một trong các tiền tố này (cách nhau dấu phẩy).
CHAT_IMAGE_PREFIXES=https://s3-han02.fptcloud.com/tns-s3/images/stagio/

# Hibernate tự tạo/sửa bảng: update (dev). Production đặt none và chạy SQL đổi cấu trúc bằng tay trước khi deploy.
JPA_DDL_AUTO=update
